# Names only. Copy this file outside the repository and fill the values there.
# Compose reads it through VOWKEY_ENV_FILE. Do not commit the copy.
# Each service receives only its own section in compose.yml; the full file is
# still needed by bootstrap.sh and backup-cron.sh. Keep this file mode 600.

# Public service hostnames, without a scheme or path. Use real hostnames in
# production and *.localhost names for the isolated local run.
VOWKEY_DOMAIN=vault.example.com
PUSH_RELAY_DOMAIN=push.example.com
BUGSINK_DOMAIN=bugsink.example.com

# Server. ADMIN_TOKEN is an Argon2id hash (see server/.env.template).
# Leave EMAIL_PROVIDER empty on a fresh local run: mail stays disabled until
# one transport below is complete (SMTP_HOST or an HTTP provider + EMAIL_API_KEY).
ADMIN_TOKEN=
HIBP_API_KEY=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
BILLING_PROVIDER=
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
BILLING_PRICE_MAP='{}'
SIGNUPS_ALLOWED=true
COUNTS_SCHEDULE="0 40 0 * * *"
EMAIL_PROVIDER=
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=accounts@mail.example.com
SMTP_FROM_NAME=Vowkey
SMTP_USERNAME=
SMTP_PASSWORD=

# Account providers. Leave a provider's credentials empty to keep it disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_NATIVE_CLIENT_ID=com.vowkey.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
SSO_ENABLED=false
SSO_AUTHORITY=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_SCOPES="email profile"
SSO_PKCE=true

# Decision relay. RELAY_SERVICE_KEY is shared only between server and relay:
# set the same value in this file once. The upstream key stays relay-only.
RELAY_SERVICE_KEY=
RELAY_USAGE_MODELS=jev-1.14.0
RELAY_UPSTREAM_URL=https://api.typesafe.ai/v1/systemone
RELAY_UPSTREAM_KEY=
RELAY_UPSTREAM_MODEL=jev-1.14.0

# Push relay and server-side push. Set host paths when the owner has real
# APNs/FCM credentials. Compose mounts these read-only; an empty path mounts
# /dev/null, so the provider remains inactive without a credential.
# Exact origin serving the public host page, not necessarily the vault hostname.
PUSH_RELAY_PUBLIC_ORIGIN=https://example.com
PUSH_INSTALLATION_ID=
PUSH_INSTALLATION_KEY=
APNS_HOST=https://api.push.apple.com
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_FILE=
APNS_TOPIC=com.vowkey.app
FCM_SERVICE_ACCOUNT_FILE=

# Bugsink. One DSN per surface, copied into the server's crash settings after
# the first start. The file-content DSNs below are client-side configuration,
# not server secrets.
BUGSINK_SECRET_KEY=
BUGSINK_ADMIN_EMAIL=
BUGSINK_ADMIN_PASSWORD=
CRASH_DSN_WEB=
CRASH_DSN_EXTENSION=
CRASH_DSN_DESKTOP=
CRASH_DSN_IOS=
CRASH_DSN_ANDROID=

# Backup. A recipient public key made by age-keygen -y; identity stays off the VM.
BACKUP_AGE_RECIPIENT=/var/lib/vowkey/backup.age.pub
BACKUP_GCS_BUCKET=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
BETTERSTACK_HEARTBEAT_URL=
COUNTS_HEARTBEAT_URL=
