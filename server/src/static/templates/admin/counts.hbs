<main class="container-xxl">
    <div class="my-3 p-3 rounded shadow">
        <h6 class="border-bottom pb-2 mb-2">Counts</h6>
        <p class="text-muted">Daily totals for the last 30 days. A cell under 5 is not shown.</p>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Day</th>
                    <th>Event</th>
                    <th>Surface</th>
                    <th>OS</th>
                    <th>Locale</th>
                    <th>Page</th>
                    <th class="text-end">Count</th>
                </tr>
            </thead>
            <tbody>
                {{#each page_data.counts}}
                <tr>
                    <td>{{utcDay}}</td>
                    <td>{{event}}</td>
                    <td>{{surface}}</td>
                    <td>{{os}}</td>
                    <td>{{locale}}</td>
                    <td>{{pageSlug}}</td>
                    <td class="text-end">{{count}}</td>
                </tr>
                {{else}}
                <tr><td colspan="7">No counts yet.</td></tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</main>
