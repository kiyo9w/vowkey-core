    "@vowkey/logging": "dist/libs/logging/src",
    "@vowkey/client-type": "dist/libs/client-type/src",
    "@vowkey/state": "dist/libs/state/src",
    "@vowkey/state-internal": "dist/libs/state-internal/src",
    "@vowkey/messaging": "dist/libs/messaging/src",
    "@vowkey/guid": "dist/libs/guid/src",
    "@vowkey/serialization": "dist/libs/serialization/src",
    "@vowkey/scheduling": "dist/libs/scheduling/src",
    "@vowkey/unlock": "dist/libs/unlock/src"
  }
