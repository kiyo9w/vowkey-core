    "@vowkey/node": "file:../../../libs/node",
    "@vowkey/storage-core": "file:../../../libs/storage-core",
    "@vowkey/logging": "dist/libs/logging/src",
    "module-alias": "2.3.4",
    "ts-node": "10.9.2",
    "yargs": "18.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.8.2"
  },
  "_moduleAliases": {
    "@vowkey/common": "dist/libs/common/src",
