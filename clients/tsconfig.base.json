{
  "compilerOptions": {
    "strict": false,
    "pretty": true,
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "target": "ES2016",
    "module": "ES2020",
    "lib": ["es5", "es6", "es7", "dom", "ES2021", "ESNext.Disposable"],
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "outDir": "dist",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "allowJs": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "paths": {
      "@vowkey/admin-console/common": ["./libs/admin-console/src/common"],
      "@vowkey/angular/*": ["./libs/angular/src/*"],
      "@vowkey/assets": ["./libs/assets/src/index.ts"],
      "@vowkey/assets/svg": ["./libs/assets/src/svg/index.ts"],
      "@vowkey/auth/angular": ["./libs/auth/src/angular"],
      "@vowkey/auth/common": ["./libs/auth/src/common"],
      "@vowkey/auto-confirm": ["./libs/auto-confirm/src/index.ts"],
      "@vowkey/auto-confirm/angular": ["./libs/auto-confirm/src/angular"],
      "@vowkey/automation-driver": ["./libs/automation-driver/src/index.ts"],
      "@vowkey/billing": ["./libs/billing/src"],
      "@vowkey/bit-common/*": ["./vowkey_license/bit-common/src/*"],
      "@vowkey/browser/*": ["./apps/browser/src/*"],
      "@vowkey/cli/*": ["./apps/cli/src/*"],
      "@vowkey/client-type": ["./libs/client-type/src/index.ts"],
      "@vowkey/common/spec": ["./libs/common/spec"],
      "@vowkey/common/*": ["./libs/common/src/*"],
      "@vowkey/components": ["./libs/components/src"],
      "@vowkey/core-test-utils": ["./libs/core-test-utils/src/index.ts"],
      "@vowkey/desktop/*": ["./apps/desktop/src/*"],
      "@vowkey/dirt-card": ["./libs/dirt/card/src"],
      "@vowkey/generator-components": ["./libs/tools/generator/components/src"],
      "@vowkey/generator-core": ["./libs/tools/generator/core/src"],
      "@vowkey/generator-history": ["./libs/tools/generator/extensions/history/src"],
      "@vowkey/generator-legacy": ["./libs/tools/generator/extensions/legacy/src"],
      "@vowkey/generator-navigation": ["./libs/tools/generator/extensions/navigation/src"],
      "@vowkey/guid": ["./libs/guid/src/index.ts"],
      "@vowkey/importer-core": ["./libs/importer/src"],
      "@vowkey/importer-ui": ["./libs/importer/src/components"],
      "@vowkey/key-management": ["./libs/key-management/src"],
      "@vowkey/key-management-ui": ["./libs/key-management-ui/src"],
      "@vowkey/legacy-crypto": ["./libs/legacy-crypto/src/index.ts"],
      "@vowkey/legacy-crypto/node": ["./libs/legacy-crypto/src/node/index.ts"],
      "@vowkey/legacy-crypto/*": ["./libs/legacy-crypto/src/*"],
      "@vowkey/logging": ["./libs/logging/src"],
      "@vowkey/logging-angular": ["./libs/logging-angular/src/index.ts"],
      "@vowkey/messaging": ["./libs/messaging/src/index.ts"],
      "@vowkey/node/*": ["./libs/node/src/*"],
      "@vowkey/nx-plugin": ["./libs/nx-plugin/src/index.ts"],
      "@vowkey/organization-invite-link": ["./libs/organization-invite-link/src/index.ts"],
      "@vowkey/platform": ["./libs/platform/src"],
      "@vowkey/platform/*": ["./libs/platform/src/*"],
      "@vowkey/pricing": ["./libs/pricing/src/index.ts"],
      "@vowkey/scheduling": ["./libs/scheduling/src/index.ts"],
      "@vowkey/send-ui": ["./libs/tools/send/send-ui/src"],
      "@vowkey/serialization": ["./libs/serialization/src/index.ts"],
      "@vowkey/state": ["./libs/state/src/index.ts"],
      "@vowkey/state-internal": ["./libs/state-internal/src/index.ts"],
      "@vowkey/state-test-utils": ["./libs/state-test-utils/src/index.ts"],
      "@vowkey/storage-core": ["./libs/storage-core/src/index.ts"],
      "@vowkey/storage-test-utils": ["./libs/storage-test-utils/src/index.ts"],
      "@vowkey/subscription": ["./libs/subscription/src/index.ts"],
      "@vowkey/ui-common": ["./libs/ui/common/src"],
      "@vowkey/ui-common/setup-jest": ["./libs/ui/common/src/setup-jest"],
      "@vowkey/unlock": ["./libs/unlock/src/index.ts"],
      "@vowkey/user-core": ["./libs/user-core/src/index.ts"],
      "@vowkey/user-crypto-management": ["./libs/user-crypto-management/src/index.ts"],
      "@vowkey/vault": ["./libs/vault/src"],
      "@vowkey/vault-export-core": ["./libs/tools/export-vault-core/src"],
      "@vowkey/vault-export-ui": ["./libs/tools/export-vault-ui/src"],
      "@vowkey/web-vault/*": ["./apps/web/src/*"],
      "@vowkey/pam": ["./libs/pam/src/index.ts"],
      "@vowkey/storybook": ["./libs/storybook/src/index.ts"],
      "@vowkey/managed-settings": ["./libs/managed-settings/src/index.ts"],
      "@vowkey/tools-share": ["./libs/tools/share/src/index.ts"]
    },
    "plugins": [
      {
        "name": "typescript-strict-plugin"
      }
    ],
    "useDefineForClassFields": false
  }
}
